<% /* archive listing — year wraps + article rows (rebuilt from artifacts) */ %>
<section class="archives-wrap">
  <div class="archive-year-wrap">
    <a href="<%- url_for('archives/' + (page.year || '')) %>" class="archive-year"><%= page.year %></a>
  </div>
  <div class="archives">
    <% page.posts.each(function(post){ %>
    <article class="archive-article archive-type-post">
  <div class="archive-article-inner">
    <header class="archive-article-header">
      <a href="<%- url_for(post.path) %>" class="archive-article-date">
  <time class="dt-published" datetime="<%= post.date.toISOString() %>" itemprop="datePublished"><%= date(post.date, 'MMM DD') %></time>
</a>


    <h1 itemprop="name">
      <a class="archive-article-title" href="<%- url_for(post.path) %>"><%= post.title %></a>
    </h1>


    </header>
  </div>
</article>
    <% }); %>
  </div>
</section>
<% if (page.total > 1) { %>
<nav id="page-nav">
  <%- paginator({ prev_text: '&laquo; Prev', next_text: 'Next &raquo;', mid_size: 2, escape: false }) %>
</nav>
<% } %>
