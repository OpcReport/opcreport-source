<%
/* OPC Report head partial — rebuilt from gh-pages artifacts */
var isPost = is_post();
var isHome = is_home();
var siteTitle = config.title; // "OPC Report"

// long site description used on home page
var siteLongDesc = theme.home_description;

function truncate160(s) {
  var t = s.replace(/<[^>]*>/g, '');
  if (t.length > 160) t = t.substring(0, 158) + '...';
  return t;
}
function cut200(s) {
  return s.replace(/&(?!(amp|lt|gt|quot|#\d+);)/g, '&amp;').substring(0, 200);
}

var pageTitle, descRaw, ogTitle;
if (isHome) {
  pageTitle = siteTitle;
  ogTitle = siteTitle;
  descRaw = siteLongDesc;
} else if (isPost) {
  pageTitle = page.title + ' | ' + siteTitle;
  ogTitle = page.title;
  descRaw = page.description || truncate160(page.content);
} else {
  pageTitle = (page.title ? page.title + ' | ' : '') + siteTitle;
  ogTitle = page.title || siteTitle;
  descRaw = page.description || String(page.content || '').replace(/<[^>]*>/g, ' ').trim();
}

var desc160 = truncate160(descRaw);
var desc200 = cut200(descRaw);
var canonical = full_url_for(path || '').replace(/index\.html$/, '');

var keywordsMeta = config.keywords;
if (isPost && page.keywords) keywordsMeta = config.keywords + ', ' + page.keywords;
%>
<head>
  <meta charset="utf-8">

  <title><%= pageTitle %></title>
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <meta name="description" content="<%= desc160 %>">
  <link rel="canonical" href="<%= canonical %>">
  <meta name="description" content="<%= desc200 %>">
<% if (isPost) { %>
<meta property="og:type" content="article">
<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:site_name" content="<%= siteTitle %>">
<meta property="og:description" content="<%= desc200 %>">
<meta property="og:locale" content="en_US">
<meta property="article:published_time" content="<%= page.date.toISOString() %>">
<meta property="article:modified_time" content="<%= page.date.toISOString() %>">
<meta property="article:author" content="<%= config.author %>">
<% page.tags.sort("name", 1).each(function(tag){ %>
<meta property="article:tag" content="<%= tag.name %>">
<% }) %>
<meta name="twitter:card" content="summary">
<% } else { %>
<meta property="og:type" content="website">
<meta property="og:title" content="<%= ogTitle %>">
<meta property="og:url" content="<%= canonical %>">
<meta property="og:site_name" content="<%= siteTitle %>">
<meta property="og:description" content="<%= desc200 %>">
<meta property="og:locale" content="en_US">
<meta property="article:author" content="<%= config.author %>">
<meta property="article:tag" content="<%= config.keywords %>">
<meta name="twitter:card" content="summary">
<% } %>

  <meta name="keywords" content="<%= keywordsMeta %>">

  <meta name="author" content="<%= config.author %>">
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">



  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= pageTitle %>">
  <meta name="twitter:description" content="<%= desc160 %>">
  <meta name="twitter:image" content="<%= config.url %>/images/logo.png">
  <meta name="twitter:site" content="<%= theme.twitter_site %>">

    <link rel="alternate" href="/atom.xml" title="<%= siteTitle %>" type="application/atom+xml">


    <link rel="shortcut icon" href="/favicon.png">



<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/typeface-source-code-pro@0.0.71/index.min.css">



<link rel="stylesheet" href="/css/style.css">



<link rel="stylesheet" href="/css/theme-override.css">



<link rel="stylesheet" href="/custom/style.css">



<link rel="stylesheet" href="/fancybox/jquery.fancybox.min.css">



<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fork-awesome@1.2.0/css/fork-awesome.min.css">







<% if (isPost) {
  var pubIso = page.date.toISOString();
  var wordCount = page.content.replace(/<[^>]*>/g, ' ').trim().split(/\s+/).length;
  var catFirst = page.categories && page.categories.length ? page.categories.first().name : '';
  var tagOrig = page.keywords ? '' : '';
  var tagNames = page.tags.map(function(t){ return t.name; }).join(', ');
%>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": "<%= ogTitle %>",
    "description": "<%= desc160.replace(/'/g, '&#39;') %>",
    "datePublished": "<%= pubIso %>",
    "dateModified": "<%= pubIso %>",
    "author": {
      "@type": "Person",
      "name": "<%= config.author %>",
      "url": "<%= config.url %>/about/"
    },
    "publisher": {
      "@type": "Organization",
      "name": "<%= siteTitle %>",
      "url": "<%= config.url %>",
      "logo": {
        "@type": "ImageObject",
        "url": "<%= config.url %>/images/logo.png",
        "width": 512,
        "height": 512
      }
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": "<%= canonical %>"
    },
    "url": "<%= canonical %>",
    "image": {
      "@type": "ImageObject",
      "url": "<%= config.url %>/images/logo.png",
      "width": 1200,
      "height": 630
    },
    "articleSection": "<%= catFirst %>",
    "wordCount": <%= wordCount %>,
    "inLanguage": "en-US"

    ,"keywords": "<%= tagNames %>"

  }
  </script>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "<%= config.url %>/"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "Archives",
        "item": "<%= config.url %>/archives/"
      },
      {
        "@type": "ListItem",
        "position": 3,
        "name": "<%= ogTitle.replace(/'/g, '&#39;') %>",
        "item": "<%= canonical %>"
      }
    ]
  }
  </script>
<% } else if (isHome) { %>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "<%= siteTitle %>",
    "url": "<%= config.url %>",
    "description": "<%= siteLongDesc %>",
    "potentialAction": {
      "@type": "SearchAction",
      "target": "<%= config.url %>/search?q={search_term_string}",
      "query-input": "required name=search_term_string"
    }
  }
  </script>
<% } %>

  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= theme.ga4_id %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= theme.ga4_id %>');
  </script>
  <!-- busuanzi visitor counter -->
  <script async src="https://busuanzi.ibruce.info/busuanzi/2.3/busuanzi.pure.mini.js"></script>
</head>
