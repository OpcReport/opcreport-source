<script>
(function(){
  var btn = document.getElementById('tagcloud-toggle-btn');
  var cloud = document.getElementById('sidebar-tagcloud');
  if (!btn || !cloud) return;
  var textSpan = btn.querySelector('.toggle-text');
  var totalLabel = textSpan ? textSpan.textContent.match(/\d+/) : null;
  var total = totalLabel ? totalLabel[0] : '';
  btn.addEventListener('click', function(){
    var expanded = cloud.classList.toggle('tagcloud-expanded');
    var collapsed = cloud.classList.toggle('tagcloud-collapsed');
    btn.classList.toggle('is-expanded', expanded);
    if (textSpan) {
      textSpan.textContent = expanded ? '收起' : '展开看全部 (' + total + ')';
    }
  });
})();
</script>
