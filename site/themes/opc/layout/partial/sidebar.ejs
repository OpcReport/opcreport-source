<aside id="sidebar">
  <div class="widget-wrap">
    <h3 class="widget-title">Recent Posts</h3>
    <div class="widget">
      <ul>
        <% site.posts.sort('date', -1).limit(8).each(function(p){ %>
          <li>
            <a href="<%- url_for(p.path) %>"><%= p.title %></a>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

  <div class="widget-wrap">
    <h3 class="widget-title">Tag Cloud</h3>
    <div class="widget tagcloud tagcloud-collapsed" id="sidebar-tagcloud">
      <%- tagcloud({min_font: 13, max_font: 13, amount: 1000, unit: 'px'}).replace(/ style="[^"]*"/g, '') %>
    </div>
    <% var tagCount = site.tags.length; %>
    <button type="button" class="tagcloud-toggle" id="tagcloud-toggle-btn">
      <span class="toggle-text"><%= theme.tagcloud_toggle %> (<%= tagCount %>)</span>
      <span class="toggle-icon">&#9662;</span>
    </button>
  </div>

  <div class="widget-wrap">
    <h3 class="widget-title">Archives</h3>
    <div class="widget">
      <%- list_archives({class_name: 'archive-list', show_count: true, format: 'MMMM YYYY', type: 'monthly', transform: false}) %>
    </div>
  </div>

</aside>
