<%
/* article page — rebuilt from gh-pages artifacts */
var post = page; /* Hexo 8: post layout exposes the post as `page` */
var wordCount = 0;
function esc(s){ return String(s).replace(/'/g, '&#39;'); }
var shareId = 'cuid' + crypto_hash(post.path);
function crypto_hash(s){
  var h = 0;
  for (var i = 0; i < s.length; i++) { h = ((h << 5) - h + s.charCodeAt(i)) | 0; }
  return Math.abs(h).toString(36) + Math.abs(h * 31).toString(36);
}
%>
<article id="post-<%= post.slug %>" class="h-entry article article-type-post" itemprop="blogPost" itemscope itemtype="https://schema.org/BlogPosting">
  <div class="article-meta">
    <a href="<%- url_for(post.path) %>" class="article-date">
  <time class="dt-published" datetime="<%= post.date.toISOString() %>" itemprop="datePublished"><%= date(post.date, 'YYYY-MM-DD') %></time>
</a>
    <% if (post.categories && post.categories.length) { %>
  <div class="article-category">
    <% post.categories.each(function(cat, i){ if (i > 0) { %>&#9656;<% } %><a class="article-category-link" href="<%- url_for(cat.path) %>"><%= cat.name %></a><% }); %>
  </div>
  <% } %>

  </div>
  <div class="article-inner">
    <% if (post.title) { %>
      <header class="article-header">


    <h1 class="p-name article-title" itemprop="headline name">
      <%= post.title %>
    </h1>


      </header>
    <% } %>
    <div class="e-content article-entry" itemprop="articleBody">
      <%- post.content %>

    </div>

    <footer class="article-footer">
      <a data-url="<%= config.url %>/<%= post.path %>" data-id="<%= shareId %>" data-title="<%= post.title %>" class="article-share-link"><span class="fa fa-share">Share</span></a>



  <ul class="article-tag-list" itemprop="keywords"><% page.tags.sort("name", 1).each(function(tag){ %><li class="article-tag-list-item"><a class="article-tag-list-link" href="<%- url_for(tag.path) %>" rel="tag"><%= tag.name %></a></li><% }); %></ul>

    </footer>
  </div>

  <% if (post.prev || post.next) { %>
<nav id="article-nav">
  <% if (post.next) { %>

    <a href="<%- url_for(post.next.path) %>" id="article-nav-older" class="article-nav-link-wrap">
      <strong class="article-nav-caption">Older</strong>
      <div class="article-nav-title"><%= post.next.title %></div>
    </a>
  <% } %>
  <% if (post.prev) { %>

    <a href="<%- url_for(post.prev.path) %>" id="article-nav-newer" class="article-nav-link-wrap">
      <strong class="article-nav-caption">Newer</strong>
      <div class="article-nav-title"><%= post.prev.title %></div>
    </a>
  <% } %>
</nav>
  <% } %>


</article>

<%
/* related reports: share-tag scoring, then newest first */
var related = [];
if (post.tags.length) {
  var tagNames = post.tags.map(function(t){ return t.name; });
  site.posts.each(function(p){
    if (p.path === post.path) return;
    var shared = p.tags.filter(function(t){ return tagNames.indexOf(t.name) >= 0; }).length;
    if (shared > 0) related.push({ post: p, score: shared });
  });
  related.sort(function(a, b){ return b.score - a.score || b.post.date.valueOf() - a.post.date.valueOf(); });
  related = related.slice(0, 4).map(function(x){ return x.post; });
}
%>
<% if (related.length) { %>
<section class="related-posts">
  <h3 class="related-posts-title">Related Reports</h3>
  <ul class="related-posts-list">
    <% related.forEach(function(p){ %>
    <li class="related-post-item">
      <a href="<%- url_for(p.path) %>" class="related-post-link">
        <span class="related-post-date"><%= date(p.date, 'YYYY-MM-DD') %></span>
        <span class="related-post-title"><%= p.title %></span>
      </a>
    </li>
    <% }); %>
  </ul>
</section>
<% } %>
